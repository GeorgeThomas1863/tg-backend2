# Telethon session — grants account access, never commit
session
*.session
*.session-journal
# scripts/check_playability.py copies the authenticated session here per run.
# Redundant with *.session above, and deliberately so: this copy is full
# account access sitting in a committed directory, so it stays named even if
# the broad rule above is ever narrowed.
backend/scripts/.probe_session.session*

# Python / uv
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
.pytest_cache/
*.egg-info/

# uv/pytest test-run scratch — agent runs have created all of these
backend/.test-tmp/
backend/.uvcache/
backend/.pytest-tmp/
backend/.Codex/

# Video block + thumbnail cache — bulk data, never commit
backend/cache/

todo.txt
todo-videos.txt
in-progress.txt
answers.txt


docs/

# Local scratch — playgrounds and one-off dev experiments
playgrounds/

# Secrets — ignore every .env variant
.env*

# Node
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*

# Vitest coverage output
coverage/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Claude Code — local scratch/screenshots, dev check scripts, per-machine settings
.claude/.tmp/
.claude/.pics/
.claude/checks/
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.*

# Superpowers SDD scratch (also self-ignored via nested .gitignore)
.superpowers/

# Stray logs
*.log

# Codex CLI per-project config — contains the Mongo connection string
.codex/

# Session history (already self-ignored via .remember/.gitignore; explicit here too)
.remember/
.playwright-mcp
